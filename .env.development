# Réglages du développement local. Chargé uniquement par « npm run dev ».
# Rien de secret ici : « demo-yeboue-tech » est un projet factice qui ne vit que
# sur les émulateurs. Ce fichier peut donc être partagé tel quel.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase, côté navigateur
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-yeboue-tech
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-yeboue-tech.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-yeboue-tech.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true

# Firebase, côté serveur : ces adresses branchent le SDK d'administration sur les émulateurs
# Les deux lignes suivantes évitent au SDK d'interroger les serveurs de Google pour deviner le projet :
# sans elles, le premier envoi de fichier reste bloqué deux minutes.
GCLOUD_PROJECT=demo-yeboue-tech
METADATA_SERVER_DETECTION=none
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
