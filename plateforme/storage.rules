rules_version = '2';

// Fermé au navigateur. Les photos sont envoyées par le serveur, qui vérifie les
// droits, et c'est lui qui les sert, à l'adresse /api/photo (ARCHITECTURE.md §17).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
