# Modèle pour la mise en ligne. À copier dans .env.production.local (jamais
# partagé), ou à saisir dans les réglages de l'hébergeur.
# En développement, rien à faire : .env.development suffit.

# L'adresse publique du site. Elle est imprimée dans chaque QR Code.
NEXT_PUBLIC_SITE_URL=https://exemple.com

# Firebase, côté navigateur : console Firebase > Paramètres du projet > Vos applications
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase, côté serveur : Paramètres du projet > Comptes de service > Générer une clé privée
# SECRET. La clé tient sur une seule ligne, entre guillemets, avec ses « \n ».
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Les e-mails (code de vérification, mot de passe oublié). Sans cette clé, rien
# ne part : le contenu de chaque e-mail s'écrit dans la console du serveur.
# SECRET. Service prévu : Resend (resend.com). Pour un autre service, voir src/lib/email/send.ts.
RESEND_API_KEY=
# L'expéditeur, sur un nom de domaine vérifié auprès du service : Yéboué Tech <bonjour@exemple.com>
EMAIL_FROM=
