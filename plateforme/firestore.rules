rules_version = '2';

// Toute lecture et toute écriture passent par le serveur, qui vérifie les
// droits (ARCHITECTURE.md §12). Le navigateur n'a donc aucun accès direct.
// Seule exception prévue : l'écoute en direct des commandes, ajoutée à l'étape 4.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
